include <iostream>
#include <stack>
using namespace std;

int main() {
    stack<int> tokens;
    int token;

    cout << "Enter 5 served token numbers:\n";

    // Store 5 token numbers in the stack
    for (int i = 0; i < 5; i++) {
        cout << "Token " << i + 1 << ": ";
        cin >> token;
        tokens.push(token);
    }

    // Display serving history
    cout << "\nServing History (Most Recent First):\n";

    while (!tokens.empty()) {
        cout << "Token No. " << tokens.top() << endl;
        tokens.pop();
    }

    return 0;
}

