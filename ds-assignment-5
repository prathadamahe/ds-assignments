#include <iostream>

using namespace std;

int main()
{
    int roll[5];

    cout << "Enter roll numbers of 5 students:\n";

    for (int i = 0; i < 5; i++)
    {
        cin >> roll[i];
    }

    cout << "\nRoll numbers of students:\n";

    for (int i = 0; i < 5; i++)
    {
        cout << roll[i] << endl;
    }

    return 0;
}
