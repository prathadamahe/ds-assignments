#include <iostream>
using namespace std;

#define SIZE 5

int main() {
    int stack[SIZE];
    int top = -1;

    // Store 5 cancelled order numbers
    cout << "Enter 5 cancelled order numbers:\n";

    for (int i = 0; i < SIZE; i++) {
        cout << "Order " << i + 1 << ": ";
        cin >> stack[++top];
    }

    // Display orders from most recently cancelled
    cout << "\nCancelled orders (most recent first):\n";

    while (top >= 0) {
        cout << stack[top] << endl;
        top--;
    }

    return 0;
}
