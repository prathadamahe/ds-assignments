#include <iostream>

using namespace std;

int main()
{
    int roll[5];
    int searchRoll;
    bool found = false;

    cout << "Enter roll numbers of 5 students:\n";

    for (int i = 0; i < 5; i++)
    {
        cin >> roll[i];
    }

    cout << "\nEnter roll number to search: ";
    cin >> searchRoll;

    for (int i = 0; i < 5; i++)
    {
        if (roll[i] == searchRoll)
        {
            found = true;
            break;
        }
    }

    if (found)
    {
        cout << "Student found";
    }
    else
    {
        cout << "Student not found";
    }

    return 0;
}
