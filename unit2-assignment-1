#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> orders;
    int orderNo;

    // Taking 5 customer orders
    cout << "Enter 5 customer order numbers:\n";

    for (int i = 1; i <= 5; i++) {
        cout << "Enter order " << i << ": ";
        cin >> orderNo;
        orders.push(orderNo);
    }

    // Processing orders in the same order received
    cout << "\nProcessing customer orders:\n";

    while (!orders.empty()) {
        cout << "Processing Order No: " << orders.front() << endl;
        orders.pop();
    }

    return 0;
}
